{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["dist", "desktop-dist", "release", "node_modules"],
  "plugins": ["typescript", "import"],
  "rules": {
    "import/no-unassigned-import": "off"
  }
}
