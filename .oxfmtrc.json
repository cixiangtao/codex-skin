{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["CHANGELOG.md", "dist", "desktop-dist", "release", "node_modules", "bun.lock"],
  "printWidth": 100,
  "semi": false,
  "sortImports": {
    "order": "asc"
  },
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./src/ui/styles.css"
  }
}
