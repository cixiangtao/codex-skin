{
  "name": "codex-skin",
  "version": "1.1.2",
  "description": "Codex 桌面端主题换装与界面美化工具，支持全局壁纸、主面板和侧边栏人物布景。",
  "keywords": [
    "chatgpt",
    "codex",
    "codex-customization",
    "codex-desktop",
    "codex-skin",
    "codex-theme",
    "codex-wallpaper",
    "customization",
    "desktop",
    "macos",
    "skin",
    "theme",
    "wallpaper"
  ],
  "homepage": "https://cixiangtao.github.io/codex-skin/",
  "bugs": {
    "url": "https://github.com/cixiangtao/codex-skin/issues"
  },
  "license": "MIT",
  "author": "anys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cixiangtao/codex-skin.git"
  },
  "bin": {
    "codex-skin": "dist/bin/codex-skin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:ui && bun run build:runtime",
    "build:runtime": "rm -rf dist/bin && bun build ./bin/codex-skin.ts --target=node --format=esm --outdir=dist/bin",
    "build:ui": "electron-vite build --mode renderer-only --ignoreConfigWarning",
    "check": "bun run format:check && bun run lint && bun run type-check",
    "check:fix": "bun run format && bun run lint:fix && bun run type-check",
    "desktop": "bun scripts/desktop-dev.ts",
    "desktop:build": "electron-vite build --ignoreConfigWarning",
    "desktop:dist": "bun run desktop:build && electron-builder --config electron-builder.yml",
    "desktop:dist:preview": "bun run desktop:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --mac dmg zip --arm64 --publish never",
    "desktop:open": "bun run desktop:pack && open \"release/mac-arm64/Codex Skin.app\"",
    "desktop:pack": "bun run desktop:build && electron-builder --config electron-builder.yml --dir",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "release": "release-it",
    "release:check": "bun run check && bun run test && npm pack --dry-run",
    "site": "vite --config vite.site.config.ts",
    "site:build": "vite build --config vite.site.config.ts",
    "site:preview": "vite preview --config vite.site.config.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "prepack": "bun run build && bun run verify:package",
    "verify:package": "bun scripts/verify-package.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "picocolors": "^1.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@locator/babel-jsx": "^0.5.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "release-it": "^20.2.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14"
}
